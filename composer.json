{
    "name": "systopia/de.systopia.civioffice",
    "description": "CiviCRM integration for various exchangeable office suites",
    "type": "civicrm-ext",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "SYSTOPIA GmbH",
            "email": "info@systopia.de",
            "homepage": "https://www.systopia.de"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "prepend-autoloader": false,
        "sort-packages": true,
        "platform": {
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "beberlei/assert": "^3",
        "civicrm/civicrm-core": ">=6.1",
        "civicrm/civicrm-packages": ">=6.1",
        "php-http/discovery": "^1.20",
        "php-http/multipart-stream-builder": "^1.4.2",
        "symfony/http-foundation": "^5.4 || ^6 || ^7 || ^8",
        "symfony/http-kernel": "^5.4 || ^6 || ^7 || ^8"
    },
    "require-dev": {
        "systopia/de.systopia.mailattachment": "^1.1"
    },
    "autoload": {
        "classmap": ["ComposerHelper.php"]
    },
    "scripts": {
        "pre-update-cmd": [
            "Civioffice\\ComposerHelper::preUpdate"
        ],
        "composer-phpcs": [
            "@composer --working-dir=tools/phpcs"
        ],
        "composer-phpstan": [
            "@composer --working-dir=tools/phpstan"
        ],
        "composer-phpunit": [
            "@composer --working-dir=tools/phpunit"
        ],
        "composer-tools": [
            "@composer-phpcs",
            "@composer-phpstan",
            "@composer-phpunit"
        ],
        "phpcs": [
            "@php tools/phpcs/vendor/bin/phpcs"
        ],
        "phpcbf": [
            "@php tools/phpcs/vendor/bin/phpcbf"
        ],
        "phpstan": [
            "@php tools/phpstan/vendor/bin/phpstan -v"
        ],
        "phpunit": [
            "@php tools/phpunit/vendor/bin/simple-phpunit --coverage-text"
        ],
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    },
    "conflict": {
        "pear/mail_mime": "<1.10.2",
        "pear/pear-core-minimal": "<1.10.16",
        "phpseclib/phpseclib": "<2.0.12 || 3.0.0 || 3.0.1",
        "phpseclib/phpseclib2_compat": "<1.0.2",
        "psr/http-message": "<1.0.1",
        "symfony/polyfill-php82": "<1.28"
    },
    "_comment": [
      "PEAR_ErrorStack::singleton() overridden in CRM_Core_Error is static since pear/pear-core v1.10.16",
      "symfony/polyfill-php82 >=1.28 is required for the ini_parse_quantity() polyfill that CiviCRM core calls during bootstrap; civicrm-core only requires ^1.0, so prefer-lowest would otherwise pick v1.27.0 (without the polyfill) and break PHPUnit on PHP 8.1"
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "2.1.x-dev"
        }
    }
}
